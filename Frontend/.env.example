# Copiar como .env y ajustar. El archivo .env NO se versiona.
# URL base del backend Go/Fiber (debe coincidir con PORT del Backend/.env).
VITE_API_URL=http://localhost:4000
# Zona horaria del negocio (nombre IANA); debe coincidir con APP_TIMEZONE del backend.
VITE_BUSINESS_TIMEZONE=America/Guayaquil
