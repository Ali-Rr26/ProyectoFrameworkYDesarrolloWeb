# Copiar como deploy/.env en el servidor y ajustar. El archivo .env NO se versiona.

# Dominios (los mismos hostnames de cloudflared/config.yml).
DOMAIN=tudominio.me
API_DOMAIN=api.tudominio.me

# PostgreSQL. Generar una contraseña propia: openssl rand -hex 24
# (solo hexadecimal: va dentro de DATABASE_URL, donde / + = romperían la URL)
POSTGRES_USER=multicatalogo
POSTGRES_PASSWORD=cambiar-esta-contrasena
POSTGRES_DB=multicatalogo

# Secreto HMAC de los JWT (mínimo 32 caracteres): openssl rand -hex 48
JWT_SECRET=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_TTL=2h

APP_TIMEZONE=America/Guayaquil
NETWORK_ROOT_EMAIL=cliente@upse.edu.ec
