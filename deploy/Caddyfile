# Detrás de Cloudflare Tunnel: Cloudflare termina el HTTPS y reenvía el tráfico por el
# túnel a http://web:80. Caddy solo sirve HTTP interno y separa PWA/API por el Host.
{
	auto_https off
}

# PWA (archivos estáticos del build de Vite).
http://{$DOMAIN} {
	root * /srv
	encode zstd gzip

	# .me no está en la lista HSTS precargada: este encabezado obliga al navegador a usar
	# HTTPS en las siguientes visitas. Sin includeSubDomains/preload a propósito.
	header Strict-Transport-Security "max-age=31536000"
	header X-Content-Type-Options "nosniff"
	header Referrer-Policy "strict-origin-when-cross-origin"

	# Los assets llevan hash en el nombre: se cachean para siempre. Un asset que no existe
	# (hash de una versión anterior) responde 404: nunca index.html con tipo HTML.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Todo lo demás se revalida siempre: sw.js, manifest.webmanifest, íconos e index.html,
	# también cuando se sirve para una ruta de la SPA (/store, /product/3...). Si alguno
	# quedara en la caché HTTP, el aviso de nueva versión (Fase 9) no se dispararía.
	handle {
		header Cache-Control "no-cache"
		# SPA: cualquier ruta desconocida la resuelve React Router desde index.html.
		try_files {path} /index.html
		file_server
	}
}

# API Go/Fiber.
http://{$API_DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy backend:4000
}
