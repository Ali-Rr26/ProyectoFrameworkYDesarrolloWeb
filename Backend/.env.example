# Copiar como .env y ajustar. El archivo .env NO se versiona.

# Cadena de conexión a PostgreSQL (docker-compose.yml publica el puerto 5434;
# usar 5432 si se trabaja con un PostgreSQL instalado localmente).
DATABASE_URL=postgres://multicatalogo:multicatalogo@localhost:5434/multicatalogo?sslmode=disable

# URI de Redis (caché Cache-Aside del catálogo y de la red). docker-compose.yml publica el 6379.
# Si Redis no responde, la API sigue funcionando contra PostgreSQL (sin caché).
# Si el 6379 del host ya está ocupado (otro Redis), publicar otro puerto y apuntar ahí:
#   REDIS_PORT=6380   (lo lee docker-compose.yml)
#   REDIS_URL=redis://localhost:6380/0
# Dentro de Docker el backend siempre usa redis://redis:6379/0 (definido en docker-compose.yml).
REDIS_URL=redis://localhost:6379/0

# Puerto HTTP del servidor Fiber (por defecto 4000; coincide con docker-compose.yml
# y con VITE_API_URL del frontend).
PORT=4000

# Zona horaria del negocio: los reportes interpretan sus fechas en ella (por defecto
# America/Guayaquil). El servidor y la base trabajan en UTC.
APP_TIMEZONE=America/Guayaquil

# Entorno: "dev" incluye el detalle técnico de los errores en APIError.details
# (nombres de restricciones, etc.). Omitido o cualquier otro valor => "production" (ocultos).
APP_ENV=dev

# Origen permitido por CORS (frontend Vite).
CORS_ORIGIN=http://localhost:5175

# Email del miembro raíz que devuelve GET /api/network cuando no se envía ?user_id=.
NETWORK_ROOT_EMAIL=cliente@upse.edu.ec

# Secreto HMAC para firmar los JWT (mínimo 32 caracteres). Generar uno propio, p. ej.:
#   PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
#   Bash:       openssl rand -base64 48
JWT_SECRET=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres

# Vigencia de los tokens (formato Go: 30m, 2h, 8h...). Por defecto 2h.
JWT_TTL=2h

# ----- Demostración de transacciones ACID (Fase 4) -----
# Desactivadas por defecto. NUNCA activarlas fuera de clase: hacen fallar las compras.
# CHECKOUT_FAIL_AT fuerza un error a mitad de la transacción del checkout:
#   after_order -> tras insertar la cabecera del pedido (ROLLBACK: no queda pedido fantasma)
#   after_items -> tras insertar las líneas (ROLLBACK: el stock descontado vuelve)
CHECKOUT_FAIL_AT=
# CHECKOUT_COMMIT_DELAY pausa justo antes del COMMIT (p. ej. 10s) para ejecutar
# `docker kill multicatalogo-db` mientras la compra está en curso.
CHECKOUT_COMMIT_DELAY=0s
